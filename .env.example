# Jira Integration Configuration (Optional)
# Set your Jira instance URL to enable clickable Jira links
NEXT_PUBLIC_JIRA_BASE_URL=https://your-company.atlassian.net

# Server-side Jira API credentials for milestone synchronization
# These are required to enable the "Sync Milestones" feature
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token-here
